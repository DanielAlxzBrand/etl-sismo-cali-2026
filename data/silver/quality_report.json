    {
      "id": "R02",
      "hallazgo": "H4",
      "columnas": "COMUNA, BARRIO",
      "filas_afectadas": 4,
      "justificacion": "Texto vacío o solo espacios pasa a nulo; no se imputa."
    },
    {
      "id": "R03",
      "hallazgo": "H2",
      "columnas": "geom_duplicada",
      "filas_afectadas": 18,
      "justificacion": "Bandera para las construcciones con geometría idéntica a otra; se conservan las filas."
    },
    {
      "id": "R04",
      "hallazgo": "H9",
      "columnas": "clase_dano",
      "filas_afectadas": 5146,
      "justificacion": "Etiqueta de Estado_Estructural a 4 clases estables; Indice_Escombros no se imputa."
    },
    {
      "id": "R05",
      "hallazgo": "H9, H12",
      "columnas": "sin_datos",
      "filas_afectadas": 435,
      "justificacion": "'Sin datos satelitales' queda como clase propia (no es 'sin daño'); sale del denominador."
    },
    {
      "id": "R06",
      "hallazgo": "H10",
      "columnas": "severo_estricto, dano_visible",
      "filas_afectadas": 4711,
      "justificacion": "Banderas D7; nulas (no falsas) cuando no hay datos satelitales."
    },
    {
      "id": "R07",
      "hallazgo": "H16",
      "columnas": "npisos, npisos_cero",
      "filas_afectadas": 1234,
      "justificacion": "NPISOS a entero nullable sin imputar; bandera para 0 pisos; no se usa como filtro."
    },
    {
      "id": "R08",
      "hallazgo": "H5",
      "columnas": "codigo_barrio",
      "filas_afectadas": 5144,
      "justificacion": "Llave del JOIN = int(COMUNA)*100 + int(BARRIO) como texto; nula si falta COMUNA o BARRIO."
    },
    {
      "id": "R09",
      "hallazgo": "H13, H18",
      "columnas": "lon, lat, codigo_poligono, nombre_poligono, coincide_poligono",
      "filas_afectadas": 5146,
      "justificacion": "Centroide de la huella (7 decimales) ubicado en los polígonos WFS 2026; solo valida la llave, no entra al JOIN."
    },
    {
      "id": "R10",
      "hallazgo": "H3, H4",
      "columnas": "OBJECTID_1, Shape__Area, Shape__Length, ID_PREDIO y demás columnas catastrales",
      "filas_afectadas": 5146,
      "justificacion": "Se descartan columnas vacías, en grados o sin uso en Gold; ver docs/hallazgos_eda.md."
    },
    {
      "id": "R11",
      "hallazgo": "H6",
      "columnas": "cod",
      "filas_afectadas": 23,
      "justificacion": "Filas 'Comuna N' y 'Otros' (código '-') se separan; no entran al JOIN."
    },
    {
      "id": "R12",
      "hallazgo": "H7",
      "columnas": "lados_e1, lados_e2, lados_e3, lados_e4, lados_e5, lados_e6, sin_vivienda",
      "filas_afectadas": 342,
      "justificacion": "Guion y vacío = 0 lados, coma de miles eliminada, columnas a entero."
    },
    {
      "id": "R13",
      "hallazgo": "H7",
      "columnas": "barrio",
      "filas_afectadas": 26,
      "justificacion": "strip y espacios internos colapsados; el archivo se lee como UTF-8."
    },
    {
      "id": "R14",
      "hallazgo": "H8",
      "columnas": "estrato",
      "filas_afectadas": 6,
      "justificacion": "estrato = moda solo si es 1-6; 'NR' queda nulo y no se convierte en estrato."
    },
    {
      "id": "R15",
      "hallazgo": "H14",
      "columnas": "pureza_estrato",
      "filas_afectadas": 343,
      "justificacion": "max(lados 1..6)/suma(lados 1..6) sin 'Sin vivienda'; nula si el total es 0."
    },
    {
      "id": "R16",
      "hallazgo": "H5, H6",
      "columnas": "codigo_barrio",
      "filas_afectadas": 5140,
      "justificacion": "LEFT JOIN construcciones <- estrato por barrio; huérfanos guardados, no descartados."
    },
    {
      "id": "R17",
